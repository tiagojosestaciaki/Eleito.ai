# =============================================================
# /web — Next.js env vars (copie para .env.local e preencha)
#
# O monorepo tem um .env.example completo na raiz. Aqui ficam
# apenas as chaves que o Next.js precisa ler diretamente.
# =============================================================

# Supabase — obtidos em
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Domínio público da app (usado em links de email etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
