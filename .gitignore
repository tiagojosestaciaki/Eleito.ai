# ============================================
# elleito.ai — .gitignore (raiz do monorepo)
# ============================================

# Ambiente
.env
.env.*
!.env.example

# Credenciais — nunca commitar nada que se pareça com chave/segredo
*.pem
*.key
*.p12
service-account*.json
google-credentials*.json
gcp-credentials*.json
*credentials*.json
*-secret.json
secrets/
.secrets/

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
.turbo/
.vercel/
*.tsbuildinfo

# pnpm / npm / yarn
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.uv/

# Supabase CLI
.supabase/

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs e tmp
logs/
*.log
tmp/
.tmp/

# Dados locais / caches de ETL
data/raw/
data/processed/
data/cache/
*.parquet
*.csv.gz

# Output de testes
coverage/
.nyc_output/
