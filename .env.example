# ==========================================================================
# elleito.ai — Variáveis de Ambiente (template)
#
# Copie este arquivo para .env.local (na raiz e/ou em /web e /ingestion)
# e preencha com valores reais. NUNCA comite arquivos .env.* de verdade.
# ==========================================================================


# --------------------------------------------------------------------------
# App / Ambiente
# --------------------------------------------------------------------------
APP_ENV=local                       # local | dev | staging | prod
APP_NAME=elleito.ai
APP_URL=http://localhost:3000
LOG_LEVEL=info                      # debug | info | warn | error
TIMEZONE=America/Sao_Paulo


# --------------------------------------------------------------------------
# Supabase (Postgres + Auth + Realtime + Storage)
#   Obtidos em: https://supabase.com/dashboard/project/_/settings/api
# --------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=                  # chave pública (usada no cliente)
SUPABASE_SERVICE_ROLE_KEY=          # chave privada (somente backend/ETL)
SUPABASE_JWT_SECRET=                # para validar JWTs no servidor
SUPABASE_DB_URL=                    # postgres://postgres:[PASSWORD]@db.xxx.supabase.co:5432/postgres

# Exposto no Next.js (prefixo NEXT_PUBLIC_ é obrigatório)
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}


# --------------------------------------------------------------------------
# Claude API (Anthropic)
#   Obtidos em: https://console.anthropic.com/settings/keys
# --------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHAT=claude-sonnet-4        # chat copiloto
ANTHROPIC_MODEL_BATCH=claude-haiku-4-5      # classificação em lote
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.2


# --------------------------------------------------------------------------
# Base dos Dados (BigQuery) — apenas para /ingestion
#   https://basedosdados.org/
#   Requer projeto GCP com BigQuery API habilitada.
# --------------------------------------------------------------------------
BD_PROJECT_ID=                              # seu project id no GCP
GOOGLE_APPLICATION_CREDENTIALS=             # path para service account JSON
BD_BILLING_PROJECT_ID=${BD_PROJECT_ID}


# --------------------------------------------------------------------------
# TSE — feed de apuração em tempo real
#   URL base do repositório público do TSE (atualizada a cada pleito)
# --------------------------------------------------------------------------
TSE_REALTIME_BASE_URL=https://resultados.tse.jus.br
TSE_REALTIME_POLL_SECONDS=60


# --------------------------------------------------------------------------
# IBGE — geometrias e indicadores
# --------------------------------------------------------------------------
IBGE_API_BASE_URL=https://servicodados.ibge.gov.br/api


# --------------------------------------------------------------------------
# Ingestão de Menções (imprensa + redes)
# --------------------------------------------------------------------------
MENTIONS_USER_AGENT=elleito.ai-crawler/1.0 (contato@elleito.ai)
MENTIONS_MAX_CONCURRENT=8
MENTIONS_REQUEST_TIMEOUT=20

# Se for usar APIs específicas (opcional, conforme integração evoluir)
TWITTER_BEARER_TOKEN=
META_GRAPH_ACCESS_TOKEN=


# --------------------------------------------------------------------------
# Observabilidade / Analytics
# --------------------------------------------------------------------------
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_API_KEY=${POSTHOG_API_KEY}
NEXT_PUBLIC_POSTHOG_HOST=${POSTHOG_HOST}

SENTRY_DSN=
SENTRY_ENVIRONMENT=${APP_ENV}


# --------------------------------------------------------------------------
# Cobrança (Fase 5)
# --------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}


# --------------------------------------------------------------------------
# Segurança / Rate limiting
# --------------------------------------------------------------------------
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_DAILY_BUDGET_USD=50
